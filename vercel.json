{
  "buildCommand": "cd game-web && bash build.sh",
  "outputDirectory": "game-web/dist",
  "installCommand": "echo skip",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
